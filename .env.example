# Public site URL, used for canonical links, sitemap, RSS and Open Graph.
NEXT_PUBLIC_SITE_URL=https://fintechpakistan.com
# Content of the Google Search Console HTML tag, if verification by meta tag is chosen.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Keystatic admin, GitHub sign-in. Created by the Keystatic setup flow (see README, "The admin").
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Set to "github" to use GitHub storage under `npm run dev` (the default there is local files).
NEXT_PUBLIC_KEYSTATIC_STORAGE=
